{
  "name": "al-xliff-studio",
  "displayName": "AL Xliff Studio",
  "description": "%extension.description%",
  "version": "1.11.101",
  "publisher": "sebastian-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "Business Central",
    "AL",
    "XLIFF",
    "translation",
    "localization",
    "Copilot",
    "XLIFF editor",
    "translation memory",
    "localization workflow",
    "dashboard",
    "terminology",
    "glossary",
    "quality assurance",
    "localization QA",
    "hover",
    "AL hover",
    "translation navigation"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:alXliffStudio.buildMaps",
    "onCommand:alXliffStudio.fillMissing",
    "onCommand:alXliffStudio.fillMissingCurrent",
    "onCommand:alXliffStudio.selectAiModel",
    "onCommand:alXliffStudio.mergeTranslations",
    "onCustomEditor:alXliffStudio.lngEditor",
    "onCustomEditor:alXliffStudio.xlfEditor",
    "onCommand:alXliffStudio.openXliffEditor",
    "onCommand:alXliffStudio.openDashboard",
    "onCommand:alXliffStudio.openAiUsage",
    "onCommand:alXliffStudio.openAiDebugLog",
    "onCommand:alXliffStudio.openPerformanceDebugLog",
    "onView:alXliffStudio.dashboardLauncher",
    "onCustomEditor:alXliffStudio.glossaryEditor",
    "onCommand:alXliffStudio.openGlossary",
    "onCommand:alXliffStudio.validateCurrent",
    "onStartupFinished",
    "onLanguage:al",
    "onCommand:alXliffStudio.openTranslationUnit",
    "onCommand:alXliffStudio.openGuidedTranslation"
  ],
  "contributes": {
    "commands": [
      {
        "command": "alXliffStudio.openDashboard",
        "title": "%command.openDashboard%",
        "icon": "$(dashboard)"
      },
      {
        "command": "alXliffStudio.openAiUsage",
        "title": "%command.openAiUsage%",
        "icon": "$(graph)"
      },
      {
        "command": "alXliffStudio.openAiDebugLog",
        "title": "%command.openAiDebugLog%",
        "icon": "$(output)"
      },
      {
        "command": "alXliffStudio.openPerformanceDebugLog",
        "title": "%command.openPerformanceDebugLog%",
        "icon": "$(pulse)"
      },
      {
        "command": "alXliffStudio.buildMaps",
        "title": "%command.buildMaps%"
      },
      {
        "command": "alXliffStudio.fillMissing",
        "title": "%command.fillMissing%"
      },
      {
        "command": "alXliffStudio.fillMissingCurrent",
        "title": "%command.fillMissingCurrent%"
      },
      {
        "command": "alXliffStudio.selectAiModel",
        "title": "%command.selectAiModel%"
      },
      {
        "command": "alXliffStudio.mergeTranslations",
        "title": "%command.mergeTranslations%"
      },
      {
        "command": "alXliffStudio.openXliffEditor",
        "title": "%command.openXliffEditor%"
      },
      {
        "command": "alXliffStudio.openGlossary",
        "title": "%command.openGlossary%",
        "icon": "$(book)"
      },
      {
        "command": "alXliffStudio.validateCurrent",
        "title": "%command.validateCurrent%",
        "icon": "$(checklist)"
      },
      {
        "command": "alXliffStudio.openGuidedTranslation",
        "title": "%command.openGuidedTranslation%",
        "icon": "$(wand)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "alXliffStudio.fillMissingCurrent",
          "when": "resourceExtname == .xlf",
          "group": "navigation@50"
        },
        {
          "command": "alXliffStudio.openXliffEditor",
          "when": "resourceExtname == .xlf",
          "group": "navigation@49"
        },
        {
          "command": "alXliffStudio.validateCurrent",
          "when": "resourceExtname == .xlf",
          "group": "navigation@48"
        }
      ],
      "editor/title/context": [
        {
          "command": "alXliffStudio.fillMissingCurrent",
          "when": "resourceExtname == .xlf",
          "group": "navigation@50"
        },
        {
          "command": "alXliffStudio.openXliffEditor",
          "when": "resourceExtname == .xlf",
          "group": "navigation@49"
        },
        {
          "command": "alXliffStudio.validateCurrent",
          "when": "resourceExtname == .xlf",
          "group": "navigation@48"
        }
      ],
      "commandPalette": [
        {
          "command": "alXliffStudio.openGuidedTranslation",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "alXliffStudio.lngEditor",
        "displayName": "%editor.alXliffStudio.lngEditor%",
        "selector": [
          {
            "filenamePattern": "*.*-*.lng"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "alXliffStudio.xlfEditor",
        "displayName": "%editor.alXliffStudio.xlfEditor%",
        "selector": [
          {
            "filenamePattern": "*.xlf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "alXliffStudio.glossaryEditor",
        "displayName": "%editor.alXliffStudio.glossaryEditor%",
        "selector": [
          {
            "filenamePattern": "**/.alxliffstudio/glossary.json"
          },
          {
            "filenamePattern": ".al-xliff-glossary.json"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "AL Xliff Studio",
      "properties": {
        "alXliffStudio.xliffGlob": {
          "type": "string",
          "default": "**/Translations/*.xlf",
          "description": "%setting.xliffGlob%"
        },
        "alXliffStudio.excludeGlob": {
          "type": "string",
          "default": "**/*.g.xlf",
          "description": "%setting.excludeGlob%"
        },
        "alXliffStudio.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.hover.enabled%"
        },
        "alXliffStudio.treatNeedsTranslationAsMissing": {
          "type": "boolean",
          "default": true,
          "description": "%setting.treatNeedsTranslationAsMissing%"
        },
        "alXliffStudio.setTranslatedState": {
          "type": "boolean",
          "default": true,
          "description": "%setting.setTranslatedState%"
        },
        "alXliffStudio.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.ai.enabled%"
        },
        "alXliffStudio.debug.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%setting.debug.enabled%"
        },
        "alXliffStudio.debug.performance.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%setting.debug.performance.enabled%"
        },
        "alXliffStudio.debug.performance.slowThresholdMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 250,
          "description": "%setting.debug.performance.slowThresholdMs%"
        },
        "alXliffStudio.performance.workerThreads.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%setting.performance.workerThreads.enabled%"
        },
        "alXliffStudio.performance.workerThreads.minFileSizeMB": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 3,
          "scope": "resource",
          "description": "%setting.performance.workerThreads.minFileSizeMB%"
        },
        "alXliffStudio.performance.workerThreads.minUnits": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000,
          "default": 5000,
          "scope": "resource",
          "description": "%setting.performance.workerThreads.minUnits%"
        },
        "alXliffStudio.performance.documentSessionCacheMB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048,
          "default": 384,
          "description": "%setting.performance.documentSessionCacheMB%"
        },
        "alXliffStudio.ai.vendor": {
          "type": "string",
          "default": "copilot",
          "description": "%setting.ai.vendor%"
        },
        "alXliffStudio.ai.family": {
          "type": "string",
          "default": "",
          "description": "%setting.ai.family%"
        },
        "alXliffStudio.ai.modelId": {
          "type": "string",
          "default": "",
          "description": "%setting.ai.modelId%"
        },
        "alXliffStudio.ai.batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "%setting.ai.batchSize%"
        },
        "alXliffStudio.ai.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.ai.usage.enabled%"
        },
        "alXliffStudio.ai.context.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.ai.context.enabled%"
        },
        "alXliffStudio.ai.context.nearbyUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 4,
          "description": "%setting.ai.context.nearbyUnits%"
        },
        "alXliffStudio.ai.context.translationMemoryExamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3,
          "description": "%setting.ai.context.translationMemoryExamples%"
        },
        "alXliffStudio.ai.context.minimumMemorySimilarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 35,
          "description": "%setting.ai.context.minimumMemorySimilarity%"
        },
        "alXliffStudio.ai.context.sameSourceContexts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3,
          "description": "%setting.ai.context.sameSourceContexts%"
        },
        "alXliffStudio.ai.context.maxCharactersPerItem": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 20000,
          "default": 6000,
          "description": "%setting.ai.context.maxCharactersPerItem%"
        },
        "alXliffStudio.validation.checkDuplicateIds": {
          "type": "boolean",
          "default": true,
          "description": "%setting.validation.checkDuplicateIds%"
        },
        "alXliffStudio.validation.checkDuplicateGeneratorNotes": {
          "type": "boolean",
          "default": true,
          "description": "%setting.validation.checkDuplicateGeneratorNotes%"
        },
        "alXliffStudio.validation.checkMaxWidth": {
          "type": "boolean",
          "default": true,
          "description": "%setting.validation.checkMaxWidth%"
        },
        "alXliffStudio.fuzzyMatch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.fuzzyMatch.enabled%"
        },
        "alXliffStudio.fuzzyMatch.minimumQuality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 80,
          "description": "%setting.fuzzyMatch.minimumQuality%"
        },
        "alXliffStudio.sourceChangeDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.sourceChangeDetection.enabled%"
        },
        "alXliffStudio.provenance.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%setting.provenance.enabled%"
        },
        "alXliffStudio.glossary.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.glossary.enabled%"
        },
        "alXliffStudio.glossary.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%setting.glossary.path%"
        },
        "alXliffStudio.quality.autoRun.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.autoRun.enabled%"
        },
        "alXliffStudio.quality.problemsNavigation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.problemsNavigation.enabled%"
        },
        "alXliffStudio.quality.maxProblemsDiagnostics": {
          "type": "integer",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000,
          "scope": "resource",
          "description": "%setting.quality.maxProblemsDiagnostics%"
        },
        "alXliffStudio.quality.checkSourceEqualsTarget": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkSourceEqualsTarget%"
        },
        "alXliffStudio.quality.checkWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkWhitespace%"
        },
        "alXliffStudio.quality.checkRepeatedWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkRepeatedWhitespace%"
        },
        "alXliffStudio.quality.checkDeveloperComment": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkDeveloperComment%"
        },
        "alXliffStudio.quality.checkPunctuation": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkPunctuation%"
        },
        "alXliffStudio.quality.checkPlaceholderOrder": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkPlaceholderOrder%"
        },
        "alXliffStudio.quality.checkFormattingSequences": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkFormattingSequences%"
        },
        "alXliffStudio.quality.checkLengthDeviation": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkLengthDeviation%"
        },
        "alXliffStudio.quality.checkNabResidues": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkNabResidues%"
        },
        "alXliffStudio.quality.checkInconsistentTranslations": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkInconsistentTranslations%"
        },
        "alXliffStudio.quality.checkSharedTargets": {
          "type": "boolean",
          "default": true,
          "description": "%setting.quality.checkSharedTargets%"
        },
        "alXliffStudio.quality.checkCopiedSourceTerms": {
          "type": "boolean",
          "default": false,
          "description": "%setting.quality.checkCopiedSourceTerms%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alXliffStudio",
          "title": "AL Xliff Studio",
          "icon": "resources/xliff-dashboard.svg"
        }
      ]
    },
    "views": {
      "alXliffStudio": [
        {
          "id": "alXliffStudio.dashboardLauncher",
          "name": "%view.alXliffStudio.dashboardLauncher%"
        }
      ]
    }
  },
  "scripts": {
    "test": "node tools/run-tests.cjs",
    "package": "vsce package --baseContentUrl https://github.com/sebastian-arlt/AL-XLiff-Studio/blob/main/ --baseImagesUrl https://raw.githubusercontent.com/sebastian-arlt/AL-XLiff-Studio/main/",
    "test:stress": "node tools/large-xlf-stress.cjs",
    "check": "node tools/check-syntax.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "acorn": "^8.19.0"
  },
  "icon": "al-xliff-studio.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-arlt/AL-XLiff-Studio.git"
  },
  "homepage": "https://github.com/sebastian-arlt/AL-XLiff-Studio#readme",
  "bugs": {
    "url": "https://github.com/sebastian-arlt/AL-XLiff-Studio/issues"
  },
  "l10n": "./l10n"
}
